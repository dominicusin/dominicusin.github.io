{
  "ci": {
    "collect": {
      "startServerCommand": null,
      "url": [
        "https://dominicusin.github.io/",
        "https://dominicusin.github.io/blog/",
        "https://dominicusin.github.io/about/",
        "https://dominicusin.github.io/2015/11/19/first/"
      ],
      "numberOfRuns": 1,
      "chromeFlags": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "categories:accessibility": ["warn", { "minScore": 0.8 }],
        "categories:best-practices": ["warn", { "minScore": 0.7 }],
        "categories:seo": ["warn", { "minScore": 0.7 }],
        "categories:pwa": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
