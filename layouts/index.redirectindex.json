{{/*
  Prebuilt redirect / smart-404 index. Output as a JSON list consumed by
  layouts/404.html. Shape: { "pages": [ { "url": "...", "title": "..." } ] }.
*/}}
{ "pages": [
  {{ range $i, $p := site.RegularPages }}
  {{- if $i }},{{ end }}
  { "url": {{ $p.RelPermalink | jsonify }}, "title": {{ $p.Title | jsonify }} }
  {{- end }}
] }
