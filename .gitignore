*.log
*.tmp
*.swp

# Environment
.env
.env.local
.env.*

# Coverage reports
coverage/
htmlcov/
*.coverage

# Build directories
dist/
build/
target/

# Hugo build output
/public/
/resources/

# Hardhat build artifacts (not committed)
artifacts/
cache_hardhat/
typechain-types/

# Hardhat build artifacts (not committed)
artifacts/
artifacts_hardhat/
cache_hardhat/
typechain-types/
cache_hardhat/

# Hugo build lock
.hugo_build.lock

# Playwright E2E
test-results/
playwright-report/
.playwright/

# Local task-system CLI installs (bmad/beads/bd/gsd/opengsd) — not project deps
.tools/

# Generated by scripts/build-knowledge-graph.cjs (CI regenerates; not committed)
static/data/knowledge-graph.json
# Generated by scripts/build-ontology-feed.cjs (CI regenerates; not committed)
static/data/ontology.json
# Generated by scripts/build-crosslinks.cjs (CI regenerates; not committed)
data/crosslinks.json

# Generated by scripts/sync-github.cjs at build time
# Repos are heavy + already work in CI (gitignored, regenerated each build).
content/repositories/
# Gist pages ARE committed: the CI gist API call can hit HTTP 403 (secondary
# rate-limit after the repo storm), so committing them guarantees /gists/ is
# never empty on deploy even if the live fetch fails. They are still refreshed
# by the sync step when the API succeeds.
data/github.json
.cache/

# OS / misc
.DS_Store
Thumbs.db

# Generated CI report artifacts (e.g. external-links-report.json from
# scripts/check-external-links.cjs). Regenerated per run; never commit.
.ci/

# Generated wiki nav (built from content/wiki submodule)
content/wiki-build/
__pycache__/
