{
  "name": "engineering-blog",
  "version": "2.0.0",
  "description": "Blog about industrial engineering, systems engineering, and data science - Refactored Edition",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "bundle exec jekyll build",
    "build:production": "JEKYLL_ENV=production bundle exec jekyll build",
    "build:test": "JEKYLL_ENV=test bundle exec jekyll build --drafts --future",
    "dev": "bundle exec jekyll serve --livereload",
    "serve": "bundle exec jekyll serve",
    "start": "bundle exec jekyll serve --port 4000 --host 0.0.0.0",
    "deploy": "npm run build:production",
    "test": "node --experimental-vm-modules node_modules/.bin/jest tests",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch tests",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage tests",
    "test:browser": "open tests/test-runner.html",
    "validate": "html-validate _site/**/*.html || true",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "audit": "npm audit",
    "audit:performance": "bundle exec jekyll serve --detach && sleep 5 && npx lighthouse http://localhost:4000 --output=json --output-path=./lighthouse-report.json && pkill -f \"jekyll serve\" || true",
    "check:web-vitals": "echo 'Checking Core Web Vitals...'",
    "analyze:size": "npm run build && du -sh _site/ && find _site/ -name '*.js' -exec wc -c {} + | sort -n",
    "clean": "rm -rf _site/ .bundle/ vendor/bundle/",
    "docs": "jsdoc src -d docs/api",
    "precommit": "npm run lint && npm run test"
  },
  "keywords": [
    "engineering",
    "blog",
    "jekyll",
    "pwa",
    "multilingual",
    "es6",
    "modules"
  ],
  "author": "DominicusIn",
  "license": "MIT",
  "devDependencies": {
    "terser": "^5.19.0",
    "cssnano": "^8.0.5",
    "html-minifier": "^4.0.0",
    "html-validate": "^11.6.2",
    "lighthouse": "^13.4.1",
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jsdoc": "^4.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "moduleFileExtensions": ["js"],
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2022": true,
      "node": true,
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "prefer-const": "error",
      "no-var": "error"
    }
  }
}
