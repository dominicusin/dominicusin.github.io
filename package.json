{
  "name": "engineering-blog",
  "version": "2.0.0",
  "description": "Blog about industrial engineering, systems engineering, and data science - Refactored Edition",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "node build.js",
    "build:production": "NODE_ENV=production node build.js && bundle exec jekyll build",
    "build:test": "NODE_ENV=test node build.js && JEKYLL_ENV=test bundle exec jekyll build --drafts --future",
    "dev": "npm run build && bundle exec jekyll serve --livereload",
    "serve": "bundle exec jekyll serve",
    "start": "bundle exec jekyll serve --port 4000 --host 0.0.0.0",
    "minify": "npm run build",
    "optimize": "npm run build",
    "optimize:assets": "npm run minify && npm run gzip",
    "gzip": "npm run build && find _site -type f \\( -name \"*.html\" -o -name \"*.css\" -o -name \"*.js\" \\) -not -name \"*.gz\" -exec gzip -k -f -9 {} \\; || true",
    "deploy": "npm run build:production",
    "test": "node tests/run-tests.js",
    "test:watch": "nodemon tests/run-tests.js",
    "test:coverage": "npx cpx 'src/**/*.js' coverage/src && echo 'Coverage: see coverage/ directory'",
    "validate": "html-validate _site/**/*.html || true",
    "lint": "eslint 'src/**/*.js' 'tests/**/*.js'",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "audit": "npm audit",
    "audit:performance": "echo 'Performance audit skipped - use Lighthouse CI in GitHub Actions' || true",
    "check:web-vitals": "echo 'Checking Core Web Vitals...' && exit 0",
    "analyze:size": "npm run build && du -sh _site/ && find _site/ -name '*.js' -exec wc -c {} + | sort -n",
    "report:build": "npm run build && echo 'Build report generated' && [ -f build-stats.json ] && cat build-stats.json || echo 'No build stats available'",
    "benchmark": "echo 'Running benchmarks...' && npm run analyze:size",
    "size-check": "echo 'Checking bundle sizes...' && du -sh _site/ | head -5",
    "clean": "rm -rf _site/ .bundle/ vendor/bundle/ coverage/",
    "docs": "jsdoc src -d docs/api",
    "precommit": "npm run lint && npm run test"
  },
  "keywords": [
    "engineering",
    "blog",
    "jekyll",
    "pwa",
    "multilingual",
    "es6",
    "modules"
  ],
  "author": "DominicusIn",
  "license": "MIT",
