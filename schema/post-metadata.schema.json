{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dominicusin.github.io/schema/post-metadata.json",
  "title": "Post Metadata Schema",
  "description": "Formal content model for blog posts in dominicusin.github.io",
  "type": "object",
  "required": [
    "title",
    "categories"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Post title (1-200 characters)"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 300,
      "description": "Optional subtitle for enhanced SEO"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Publication date in ISO 8601 format (YYYY-MM-DDTHH:MM:SS+HH:MM)"
    },
    "last_modified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification date in ISO 8601 format"
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "description": "Author identifier (must exist in _people/)"
    },
    "coauthors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Optional list of co-author identifiers"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "enum": [
          "architecture",
          "refactoring",
          "ai-agents",
          "web-performance",
          "pwa",
          "testing",
          "documentation",
          "devops",
          "security",
          "accessibility",
          "jekyll",
          "update",
          "notes",
          "links",
          "systems",
          "web",
          "ai",
          "media",
          "career",
          "philosophy",
          "dao"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "description": "Post categories (1-3, must be from predefined list; legacy jekyll/update kept for migrated posts)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "minLength": 2,
        "maxLength": 30,
        "enum": [
          "gist",
          "code",
          "architecture",
          "refactoring",
          "ai-agents",
          "web-performance",
          "pwa",
          "testing",
          "documentation",
          "devops",
          "security",
          "accessibility",
          "about",
          "applications",
          "arch",
          "automation",
          "awesome-list",
          "books",
          "chat",
          "chroot",
          "cli",
          "cloud",
          "commit-reveal",
          "courses",
          "craft",
          "cv",
          "cybersecurity",
          "darknet",
          "decentralization",
          "dns",
          "editors",
          "essay",
          "flatpak",
          "forth",
          "free-resources",
          "gcloud",
          "git",
          "github",
          "governance",
          "guix",
          "hardening",
          "humor",
          "interview",
          "jekyll",
          "jobs",
          "knowledge-graph",
          "languages",
          "linux",
          "llm",
          "logic",
          "lua",
          "macos",
          "media",
          "meta",
          "ml",
          "movies",
          "neovim",
          "networking",
          "networks",
          "nsfw",
          "operating-systems",
          "piracy",
          "plan9",
          "podcasts",
          "privacy",
          "productivity",
          "programming",
          "prompting",
          "reasoning",
          "scheme",
          "screencasts",
          "self-hosting",
          "sftp",
          "smart-contracts",
          "social",
          "solidity",
          "storage",
          "tools",
          "tor",
          "tunneling",
          "visualization",
          "web",
          "windows",
          "zfs"
        ]
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "description": "Post tags (1-10, lowercase alphanumeric with hyphens; legacy gist/code kept for migrated posts)"
    },
    "layout": {
      "type": "string",
      "enum": ["post", "page", "archive"],
      "default": "post",
      "description": "Jekyll layout template"
    },
    "permalink": {
      "type": "string",
      "pattern": "^/[0-9]{4}/[0-9]{2}/[0-9]{2}/[a-z0-9-]+/$",
      "description": "URL path matching pattern: /YYYY/MM/DD/slug/"
    },
    "excerpt": {
      "type": "string",
      "maxLength": 300,
      "description": "Short summary for RSS and social sharing (auto-generated if omitted)"
    },
    "header": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^/assets/images/",
          "description": "Path to header image in /assets/images/"
        },
        "alt": {
          "type": "string",
          "maxLength": 125,
          "description": "Alt text for header image (accessibility requirement)"
        }
      },
      "required": ["image", "alt"],
      "if": {
        "required": ["image"]
      },
      "then": {
        "required": ["alt"]
      }
    },
    "toc": {
      "type": "boolean",
      "default": true,
      "description": "Show table of contents"
    },
    "comments": {
      "type": "boolean",
      "default": true,
      "description": "Enable comments section"
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Publication status (false for drafts)"
    },
    "draft": {
      "type": "boolean",
      "default": false,
      "description": "Draft flag (mutually exclusive with published)"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Mark as featured post"
    },
    "series": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["name", "order"],
      "description": "Series metadata for multi-part articles"
    },
    "related_posts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
      },
      "maxItems": 5,
      "uniqueItems": true,
      "description": "Manually curated related post IDs (slug format)"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Concept identifier for Knowledge Graph"
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "relation": {
            "type": "string",
            "enum": ["defines", "references", "extends", "critiques", "implements"],
            "description": "Relationship type to the concept"
          }
        },
        "required": ["id", "label", "relation"]
      },
      "minItems": 1,
      "description": "Semantic concepts referenced in this post for Knowledge Graph construction"
    },
    "seo": {
      "type": "object",
      "properties": {
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://dominicusin\\.github\\.io/"
        },
        "noindex": {
          "type": "boolean",
          "default": false
        },
        "nofollow": {
          "type": "boolean",
          "default": false
        },
        "robots": {
          "type": "string",
          "enum": ["index, follow", "noindex, follow", "index, nofollow", "noindex, nofollow"]
        }
      },
      "description": "SEO-specific metadata overrides"
    },
    "social": {
      "type": "object",
      "properties": {
        "twitter_card": {
          "type": "string",
          "enum": ["summary", "summary_large_image"],
          "default": "summary_large_image"
        },
        "og_type": {
          "type": "string",
          "enum": ["article", "blog"],
          "default": "article"
        },
        "disable_sharing": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Social media sharing configuration"
    },
    "analytics": {
      "type": "object",
      "properties": {
        "track_scroll_depth": {
          "type": "boolean",
          "default": true
        },
        "track_time_on_page": {
          "type": "boolean",
          "default": true
        },
        "custom_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Analytics tracking configuration"
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "wcag_level": {
          "type": "string",
          "enum": ["A", "AA", "AAA"],
          "default": "AA"
        },
        "screen_reader_notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "description": "Accessibility compliance metadata"
    }
  },
  "additionalProperties": true,
  "oneOf": [
    {
      "properties": {
        "published": { "const": true },
        "draft": { "const": false }
      }
    },
    {
      "properties": {
        "published": { "const": false },
        "draft": { "const": true }
      }
    }
  ],
  "errorMessage": {
    "oneOf": "A post cannot be both published and draft simultaneously"
  }
}
